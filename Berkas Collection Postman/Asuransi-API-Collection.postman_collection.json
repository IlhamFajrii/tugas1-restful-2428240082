              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code adalah 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Respons pembaruan menunjukkan polis yang benar\", function () {\r\n    const body = pm.response.json();\r\n\r\n    pm.expect(body.status).to.eql(\"success\");\r\n    pm.expect(String(body.data.id)).to.eql(\r\n        pm.environment.get(\"createdPolicyId\")\r\n    );\r\n});"
