        {
          "name": "Tambah Polis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code adalah 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Respons berisi status sukses dan ID polis\", function () {\r\n    const body = pm.response.json();\r\n\r\n    pm.expect(body.status).to.eql(\"success\");\r\n    pm.expect(body.data).to.have.property(\"id\");\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const body = pm.response.json();\r\n\r\n    if (body.data && body.data.id !== undefined) {\r\n        pm.environment.set(\r\n            \"createdPolicyId\",\r\n            String(body.data.id)\r\n        );\r\n    }\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api-key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nomorPolis\": \"POL-2026-001\",\r\n  \"namaPemegang\": \"Budi Santoso\",\r\n  \"jenis\": \"kesehatan\",\r\n  \"premiBulanan\": 250000,\r\n  \"tanggalMulai\": \"2026-10-19\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/insurance-policies",
