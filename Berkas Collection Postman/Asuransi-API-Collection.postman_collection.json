              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code adalah 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Respons memiliki data polis\", function () {\n    const body = pm.response.json();\n\n    pm.expect(body).to.be.an(\"object\");\n    pm.expect(body).to.have.property(\"id\");\n    pm.expect(body).to.have.property(\"nomorPolis\");\n    pm.expect(body).to.have.property(\"namaPemegang\");\n\n    pm.expect(String(body.id)).to.eql(\n        pm.environment.get(\"createdPolicyId\")\n    );\n});"
                ]
