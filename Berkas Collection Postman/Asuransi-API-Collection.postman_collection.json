              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code adalah 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Respons berupa array JSON\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body).to.be.an(\"array\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/insurance-policies",
              "host": [
